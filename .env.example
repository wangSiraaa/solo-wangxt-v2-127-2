# PostgreSQL DSN (psycopg3), e.g.
EMLARCH_DATABASE_DSN=postgresql://user:pass@localhost:5432/emlarch
# Controlled root directories. Attachments and raw EMLs never escape these.
EMLARCH_ATTACHMENT_DIR=/var/lib/emlarchive/attachments
EMLARCH_RAW_DIR=/var/lib/emlarchive/raw
# Maximum accepted upload size (bytes). 0 = use python-multipart default header only
EMLARCH_MAX_UPLOAD_BYTES=52428800
# 0600 = owner read/write only for stored attachment files
EMLARCH_FILE_MODE=384
# --- Controlled ZIP batch import (POST /ingest/batch) ---
# Hard cap on the uploaded .zip bytes (streaming, before opening the archive).
EMLARCH_ZIP_MAX_UPLOAD_BYTES=104857600
# Max central-directory entries (incl. directories) and max regular .eml members.
EMLARCH_ZIP_MAX_ENTRIES=10000
EMLARCH_ZIP_MAX_EML=1000
# Cap on the sum of inflated member bytes and on one inflated .eml member.
EMLARCH_ZIP_MAX_TOTAL_BYTES=209715200
EMLARCH_ZIP_MAX_MEMBER_BYTES=52428800
# Inflated/compressed ratio (past a 1 MiB noise floor) treated as a zip bomb.
EMLARCH_ZIP_MAX_RATIO=200
